{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "ilink-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-26",
  // 非敏感变量：直接放在这里。
  // 敏感凭证（ADMIN_TOKEN / WEBHOOK_SHARED_TOKEN / BOT_STATE_ENC_KEY）——不要放在 vars！
  // 部署前通过以下命令注入 Secret：
  //   npx wrangler secret put ADMIN_TOKEN
  //   npx wrangler secret put WEBHOOK_SHARED_TOKEN
  //   npx wrangler secret put BOT_STATE_ENC_KEY
  "vars": {
    "ILINK_BASE_URL": "https://ilinkai.weixin.qq.com",
    "KEEPALIVE_ENABLED": "true",
    "KEEPALIVE_INTERVAL_HOURS": "24",
    "KEEPALIVE_TEXT": "【保活提醒】请和微信 ClawBot 进行一次交互，保持 iLink 上下文可用。"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // 替换为你自己的 D1 数据库 ID。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ilink-cloudflare",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        // 替换为你自己的队列名。
        "binding": "NOTIFICATION_QUEUE",
        "queue": "ilink-notification-queue"
      }
    ],
    "consumers": [
      {
        "queue": "ilink-notification-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  }
}
